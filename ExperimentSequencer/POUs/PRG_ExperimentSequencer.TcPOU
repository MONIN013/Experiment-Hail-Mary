<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="PRG_ExperimentSequencer" Id="{518793a6-a82c-47c2-829c-15995f9de9f5}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_ExperimentSequencer
VAR
    tableIdxDint : DINT := 0;
    tableLenLocal : UDINT := 0;
    tableLenMaxLocal : UDINT := 0;
    refSample : LREAL := 0.0;
    ffSample : LREAL := 0.0;
    distSample : LREAL := 0.0;
    fbSequencerCore : FB_ExperimentSequencerCore;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[tableLenMaxLocal := GVL_SEQ.N_REF_MAX;
IF GVL_SEQ.N_FF_MAX < tableLenMaxLocal THEN
    tableLenMaxLocal := GVL_SEQ.N_FF_MAX;
END_IF
IF GVL_SEQ.N_DIST_MAX < tableLenMaxLocal THEN
    tableLenMaxLocal := GVL_SEQ.N_DIST_MAX;
END_IF

tableLenLocal := GVL_SEQ.tableLen;
IF tableLenLocal > tableLenMaxLocal THEN
    tableLenLocal := tableLenMaxLocal;
END_IF
GVL_SEQ.tableLenClamped := tableLenLocal;

refSample := 0.0;
ffSample := 0.0;
distSample := 0.0;
IF fbSequencerCore.idx < tableLenLocal THEN
    tableIdxDint := UDINT_TO_DINT(fbSequencerCore.idx);
    refSample := GVL_SEQ.refTable[tableIdxDint];
    ffSample := GVL_SEQ.ffTable[tableIdxDint];
    distSample := GVL_SEQ.distTable[tableIdxDint];
END_IF

fbSequencerCore(
    resetRequest := GVL_SEQ.resetReq,
    experimentActive := GVL_SEQ.experimentActive,
    tableLen := tableLenLocal,
    repeatCount := GVL_SEQ.repeatCount,
    refSample := refSample,
    ffSample := ffSample,
    distSample := distSample
);

GVL_SEQ.refValue := fbSequencerCore.refValue;
GVL_SEQ.ffValue := fbSequencerCore.ffValue;
GVL_SEQ.distValue := fbSequencerCore.distValue;
GVL_SEQ.playbackDone := fbSequencerCore.playbackDone;
GVL_SEQ.seqError := fbSequencerCore.seqError;
GVL_SEQ.seqState := fbSequencerCore.seqState;
GVL_SEQ.idx := fbSequencerCore.idx;
GVL_SEQ.trialIndex := fbSequencerCore.trialIndex;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
