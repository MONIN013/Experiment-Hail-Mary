<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="PRG_ExperimentSequencer" Id="{518793a6-a82c-47c2-829c-15995f9de9f5}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_ExperimentSequencer
VAR
    tableIdxDint : DINT := 0;
    tableLenLocal : UDINT := 0;
    tableLenMaxLocal : UDINT := 0;
    refValueLocal : LREAL := 0.0;
    ffValueLocal : LREAL := 0.0;
    distValueLocal : LREAL := 0.0;
    cmdActivePrev : BOOL := FALSE;
    resetReqPrev : BOOL := FALSE;
    resetEdge : BOOL := FALSE;
    startEdge : BOOL := FALSE;
    sampleEmittedThisScan : BOOL := FALSE;
    logWriteIdx : DINT := 0;
    wrPos : UDINT := 0;
    loggedIdx : UDINT := 0;
    absoluteIdxBase : UDINT := 0;
    targetCurrentLocal : LREAL := 0.0;
    seqState : E_SeqState := E_SeqState.IDLE;
END_VAR
VAR CONSTANT
    TASK_DT_NS : ULINT := ULINT#1000000;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[sampleEmittedThisScan := FALSE;
resetEdge := GVL_SEQ.resetReq AND NOT resetReqPrev;
startEdge := GVL_SEQ.experimentActive AND NOT cmdActivePrev;

tableLenMaxLocal := GVL_SEQ.N_REF_MAX;
IF GVL_SEQ.N_FF_MAX < tableLenMaxLocal THEN
    tableLenMaxLocal := GVL_SEQ.N_FF_MAX;
END_IF
IF GVL_SEQ.N_DIST_MAX < tableLenMaxLocal THEN
    tableLenMaxLocal := GVL_SEQ.N_DIST_MAX;
END_IF

tableLenLocal := GVL_SEQ.tableLen;
IF tableLenLocal > tableLenMaxLocal THEN
    tableLenLocal := tableLenMaxLocal;
END_IF
GVL_SEQ.tableLenClamped := tableLenLocal;

IF resetEdge THEN
    GVL_SEQ.idx := 0;
    GVL_SEQ.trialIndex := 0;
    GVL_SEQ.refValue := 0.0;
    GVL_SEQ.ffValue := 0.0;
    GVL_SEQ.distValue := 0.0;
    GVL_SEQ.playbackDone := FALSE;
    seqState := E_SeqState.IDLE;

    GVL_SEQ_LOG.seq := 0;
    GVL_SEQ_LOG.tNs := 0;
    GVL_SEQ_LOG.wrIdx := 0;
    GVL_SEQ_LOG.rdIdx := 0;
    GVL_SEQ_LOG.overflow := FALSE;
ELSE
    CASE seqState OF
        E_SeqState.IDLE:
            GVL_SEQ.refValue := 0.0;
            GVL_SEQ.ffValue := 0.0;
            GVL_SEQ.distValue := 0.0;
            GVL_SEQ.playbackDone := FALSE;

            IF startEdge THEN
                IF (tableLenLocal = 0) OR (GVL_SEQ.repeatCount = 0) THEN
                    seqState := E_SeqState.FAULT;
                ELSE
                    GVL_SEQ.idx := 0;
                    GVL_SEQ.trialIndex := 0;
                    GVL_SEQ.playbackDone := FALSE;
                    seqState := E_SeqState.PLAYING;
                END_IF
            END_IF

        E_SeqState.PLAYING:
            IF NOT GVL_SEQ.experimentActive THEN
                GVL_SEQ.idx := 0;
                GVL_SEQ.trialIndex := 0;
                GVL_SEQ.refValue := 0.0;
                GVL_SEQ.ffValue := 0.0;
                GVL_SEQ.distValue := 0.0;
                GVL_SEQ.playbackDone := FALSE;
                seqState := E_SeqState.IDLE;
            ELSIF GVL_SEQ.idx < tableLenLocal THEN
                tableIdxDint := UDINT_TO_DINT(GVL_SEQ.idx);

                refValueLocal := GVL_SEQ.refTable[tableIdxDint];
                ffValueLocal := GVL_SEQ.ffTable[tableIdxDint];
                distValueLocal := GVL_SEQ.distTable[tableIdxDint];
                absoluteIdxBase := GVL_SEQ.trialIndex * tableLenLocal;
                loggedIdx := absoluteIdxBase + GVL_SEQ.idx;

                GVL_SEQ.refValue := refValueLocal;
                GVL_SEQ.ffValue := ffValueLocal;
                GVL_SEQ.distValue := distValueLocal;

                GVL_SEQ.idx := GVL_SEQ.idx + 1;
                sampleEmittedThisScan := TRUE;

                IF GVL_SEQ.idx >= tableLenLocal THEN
                    IF GVL_SEQ.trialIndex >= (GVL_SEQ.repeatCount - 1) THEN
                        GVL_SEQ.playbackDone := TRUE;
                        seqState := E_SeqState.COMPLETE;
                    ELSE
                        GVL_SEQ.idx := 0;
                        GVL_SEQ.trialIndex := GVL_SEQ.trialIndex + 1;
                    END_IF
                END_IF
            END_IF

        E_SeqState.COMPLETE:
            IF NOT GVL_SEQ.experimentActive THEN
                GVL_SEQ.idx := 0;
                GVL_SEQ.trialIndex := 0;
                GVL_SEQ.playbackDone := FALSE;
                GVL_SEQ.refValue := 0.0;
                GVL_SEQ.ffValue := 0.0;
                GVL_SEQ.distValue := 0.0;
                seqState := E_SeqState.IDLE;
            END_IF

        E_SeqState.FAULT:
            GVL_SEQ.idx := 0;
            GVL_SEQ.trialIndex := 0;
            GVL_SEQ.refValue := 0.0;
            GVL_SEQ.ffValue := 0.0;
            GVL_SEQ.distValue := 0.0;
            GVL_SEQ.playbackDone := FALSE;
    END_CASE
END_IF

GVL_SEQ.seqState := seqState;
GVL_SEQ.seqError := (seqState = E_SeqState.FAULT);

IF sampleEmittedThisScan THEN
    wrPos := GVL_SEQ_LOG.wrIdx MOD GVL_SEQ_LOG.LOG_N;
    logWriteIdx := UDINT_TO_DINT(wrPos);
    targetCurrentLocal := GVL_SEQ_LOG.controlInputTap + GVL_SEQ.distValue;

    GVL_SEQ_LOG.seq := GVL_SEQ_LOG.seq + 1;
    GVL_SEQ_LOG.tNs := UDINT_TO_ULINT(GVL_SEQ_LOG.seq) * TASK_DT_NS;

    GVL_SEQ_LOG.logSeq[logWriteIdx] := GVL_SEQ_LOG.seq;
    GVL_SEQ_LOG.logRefValue[logWriteIdx] := GVL_SEQ.refValue;
    GVL_SEQ_LOG.logFfValue[logWriteIdx] := GVL_SEQ.ffValue;
    GVL_SEQ_LOG.logDistValue[logWriteIdx] := GVL_SEQ.distValue;
    GVL_SEQ_LOG.logControlInput[logWriteIdx] := GVL_SEQ_LOG.controlInputTap;
    GVL_SEQ_LOG.logTargetCurrent[logWriteIdx] := targetCurrentLocal;
    GVL_SEQ_LOG.logPositionAct[logWriteIdx] := GVL_SEQ_LOG.positionRelTap;
    GVL_SEQ_LOG.logT[logWriteIdx] := GVL_SEQ_LOG.tNs;
    GVL_SEQ_LOG.logIdx[logWriteIdx] := loggedIdx;

    GVL_SEQ_LOG.wrIdx := GVL_SEQ_LOG.wrIdx + 1;
    IF (GVL_SEQ_LOG.wrIdx - GVL_SEQ_LOG.rdIdx) > GVL_SEQ_LOG.LOG_N THEN
        GVL_SEQ_LOG.overflow := TRUE;
    END_IF
END_IF

cmdActivePrev := GVL_SEQ.experimentActive;
resetReqPrev := GVL_SEQ.resetReq;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
