<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_SEQ_LOG" Id="{f2cb075b-543c-47f0-8f85-3ac426bfc632}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
    LOG_N : UDINT := 200000;
END_VAR

VAR_GLOBAL
    seq : UDINT := 0;
    tNs : ULINT := 0;
    wrIdx : UDINT := 0;
    rdIdx : UDINT := 0;
    overflow : BOOL := FALSE;

    {attribute 'linkalways'}
    controlInputTap AT %I* : LREAL := 0.0;

    {attribute 'linkalways'}
    positionRelTap AT %I* : LREAL := 0.0;

    logSeq : ARRAY[0..LOG_N - 1] OF UDINT;
    logRefValue : ARRAY[0..LOG_N - 1] OF LREAL;
    logFfValue : ARRAY[0..LOG_N - 1] OF LREAL;
    logDistValue : ARRAY[0..LOG_N - 1] OF LREAL;
    logControlInput : ARRAY[0..LOG_N - 1] OF LREAL;
    logTargetTorque : ARRAY[0..LOG_N - 1] OF LREAL;
    logPositionAct : ARRAY[0..LOG_N - 1] OF LREAL;
    logT : ARRAY[0..LOG_N - 1] OF ULINT;
    logIdx : ARRAY[0..LOG_N - 1] OF UDINT;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>

