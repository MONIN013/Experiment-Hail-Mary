<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_SEQ" Id="{33955021-1663-4825-9072-9080eda5b96e}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
    N_REF_MAX : UDINT := 100000;
    N_FF_MAX : UDINT := 100000;
    N_DIST_MAX : UDINT := 100000;
END_VAR

VAR_GLOBAL
    {attribute 'linkalways'}
    refValue AT %Q* : LREAL := 0.0;

    {attribute 'linkalways'}
    ffValue AT %Q* : LREAL := 0.0;

    {attribute 'linkalways'}
    distValue AT %Q* : LREAL := 0.0;

    refTable : ARRAY[0..N_REF_MAX - 1] OF LREAL;
    ffTable : ARRAY[0..N_FF_MAX - 1] OF LREAL;
    distTable : ARRAY[0..N_DIST_MAX - 1] OF LREAL;
    tableLen : UDINT := 0;
    idx : UDINT := 0;
    repeatCount : UDINT := 1;
    trialIndex : UDINT := 0;

    {attribute 'linkalways'}
    resetReq AT %I* : BOOL := FALSE;

    {attribute 'linkalways'}
    experimentActive AT %I* : BOOL := FALSE;

    {attribute 'linkalways'}
    playbackDone AT %Q* : BOOL := FALSE;

    {attribute 'linkalways'}
    seqError AT %Q* : BOOL := FALSE;

    seqState : E_SeqState := E_SeqState.IDLE;
    tableLenClamped : UDINT := 0;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>
