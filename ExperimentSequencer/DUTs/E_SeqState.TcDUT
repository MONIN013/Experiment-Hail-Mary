<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_SeqState" Id="{3fd10f4f-4d42-4df1-977a-53bdcca5f1fb}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_SeqState :
(
    IDLE := 0,          (* Waiting. Outputs zeroed. *)
    PLAYING := 10,      (* Table playback active. *)
    COMPLETE := 20,     (* Playback complete, outputs held until rearm. *)
    FAULT := 90         (* Invalid input detected, reset edge required. *)
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
