<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="PRG_VM_Logger" Id="{da4fe8bb-b82a-49b8-ba08-c7f24c56f56d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_VM_Logger
VAR
    cmd_profile_idx : DINT := 0;
    log_write_idx : DINT := 0;
    wr_pos : UDINT := 0;
    cmd_value : LREAL := 0.0;
    VM_TASK_DT_NS : ULINT := ULINT#1000000;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Reset one-shot from host side.
IF GVL_VM.reset_req THEN
    GVL_VM.experiment_start := FALSE;
    GVL_VM.cmd_len := 0;
    GVL_VM.cmd_idx := 0;
    GVL_VM.current_in := 0.0;
    GVL_VM_LOG.seq := 0;
    GVL_VM_LOG.t_ns := 0;
    GVL_VM_LOG.wr_idx := 0;
    GVL_VM_LOG.rd_idx := 0;
    GVL_VM_LOG.overflow := FALSE;
    GVL_VM.reset_req := FALSE;
END_IF

// Profile player + logger: one sample per cycle.
IF GVL_VM.experiment_start THEN
    IF (GVL_VM.cmd_idx < GVL_VM.cmd_len) THEN
        cmd_profile_idx := UDINT_TO_DINT(GVL_VM.cmd_idx);
        wr_pos := GVL_VM_LOG.wr_idx MOD GVL_VM_LOG.LOG_N;
        log_write_idx := UDINT_TO_DINT(wr_pos);

        cmd_value := GVL_VM.cmd_profile[cmd_profile_idx];
        GVL_VM.current_in := cmd_value;

        // 実験シークエンスをカウントアップ simulinkのcountに相当
        GVL_VM_LOG.seq := GVL_VM_LOG.seq + 1;
        // シークエンスに基づいて、現在の時刻を計算 simulinkのtimeに相当
        GVL_VM_LOG.t_ns := UDINT_TO_ULINT(GVL_VM_LOG.seq) * VM_TASK_DT_NS;

        // ログ配列に現在の入力、出力、時刻を保存
        GVL_VM_LOG.log_seq[log_write_idx] := GVL_VM_LOG.seq;
        GVL_VM_LOG.log_i[log_write_idx] := cmd_value;
        GVL_VM_LOG.log_x[log_write_idx] := GVL_VM.position_out;
        GVL_VM_LOG.log_t[log_write_idx] := GVL_VM_LOG.t_ns;
        GVL_VM_LOG.log_cmd_idx[log_write_idx] := GVL_VM.cmd_idx;
        GVL_VM_LOG.log_cmd_value[log_write_idx] := cmd_value;

        GVL_VM.cmd_idx := GVL_VM.cmd_idx + 1;
        GVL_VM_LOG.wr_idx := GVL_VM_LOG.wr_idx + 1;

        IF (GVL_VM_LOG.wr_idx - GVL_VM_LOG.rd_idx) > GVL_VM_LOG.LOG_N THEN
            GVL_VM_LOG.overflow := TRUE;
        END_IF
    ELSE
        GVL_VM.experiment_start := FALSE;
        GVL_VM.current_in := 0.0;
    END_IF
END_IF
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
