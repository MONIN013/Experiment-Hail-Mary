<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_VM" Id="{f0861b0b-0c5a-426d-abce-12fba38ed0b0}">
    <Declaration><![CDATA[{attribute 'linkalways'}
VAR_GLOBAL CONSTANT
    CMD_MAX_N : UDINT := 100000;
END_VAR

VAR_GLOBAL
	{attribute 'linkalways'}
    current_in AT %Q* : LREAL := 0.0;
    
    {attribute 'linkalways'}
    position_out AT %I* : LREAL := 0.0;

    {attribute 'linkalways'}      
    velocity_out AT %I* : LREAL := 0.0;

    cmd_profile : ARRAY[0..CMD_MAX_N - 1] OF LREAL;
    cmd_len : UDINT := 0;
    cmd_idx : UDINT := 0;

    reset_req : BOOL := FALSE;
    experiment_start : BOOL := FALSE;
END_VAR
]]></Declaration>
  </GVL>
