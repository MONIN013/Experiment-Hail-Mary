<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_EXE" Id="{19627e52-d80e-43e5-87f6-80109328137a}">
    <Declaration><![CDATA[{attribute 'linkalways'}
VAR_GLOBAL CONSTANT
    TABLE_MAX_N : UDINT := 100000;
END_VAR

VAR_GLOBAL
	{attribute 'linkalways'}
    target_torque AT %Q* : LREAL := 0.0;
    
    {attribute 'linkalways'}
    control_input AT %I* : LREAL := 0.0;

    {attribute 'linkalways'}
    position_act_log AT %I* : LREAL := 0.0;

    ref_table : ARRAY[0..TABLE_MAX_N - 1] OF LREAL;
    ff_table : ARRAY[0..TABLE_MAX_N - 1] OF LREAL;
    dist_table : ARRAY[0..TABLE_MAX_N - 1] OF LREAL;
    table_len : UDINT := 0;
    idx : UDINT := 0;

    ref_value : LREAL := 0.0;
    ff_value : LREAL := 0.0;
    mode_flags : UINT := 0;
    reset_req : BOOL := FALSE;
    experiment_active : BOOL := FALSE;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>