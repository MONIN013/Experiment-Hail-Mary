<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_VM_LOG" Id="{4fd1d15b-6d27-4ebd-b050-15c887ff8a41}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
    LOG_N : UDINT := 200000;
END_VAR

VAR_GLOBAL
    seq : UDINT := 0;
    t_ns : ULINT := 0;
    wr_idx : UDINT := 0;
    rd_idx : UDINT := 0;
    overflow : BOOL := FALSE;

    log_seq : ARRAY[0..LOG_N - 1] OF UDINT;
    log_i : ARRAY[0..LOG_N - 1] OF LREAL;
    log_x : ARRAY[0..LOG_N - 1] OF LREAL;
    log_t : ARRAY[0..LOG_N - 1] OF ULINT;
    log_cmd_idx : ARRAY[0..LOG_N - 1] OF UDINT;
    log_cmd_value : ARRAY[0..LOG_N - 1] OF LREAL;
END_VAR
]]></Declaration>
  </GVL>
</TcPlcObject>
