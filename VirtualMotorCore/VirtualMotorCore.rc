/////////////////////////////////////////////////////////////////////////////
//
// Version
//

#include "VirtualMotorCoreVersion.h"

#define RC_MAKE_STR(m) #m
#define RC_MACRO_AS_STR(m) RC_MAKE_STR(m)

#define RC_FILE_DESCRIPTION "TwinCAT C++ Executable for '" RC_MACRO_AS_STR(TC_CFG_PLTF) "'"



1 VERSIONINFO
 FILEVERSION VirtualMotorCore_FileVersionMajor, VirtualMotorCore_FileVersionMinor, VirtualMotorCore_FileVersionBuild, VirtualMotorCore_FileVersionRevision
 PRODUCTVERSION VirtualMotorCore_ProductMajor, VirtualMotorCore_ProductMinor, VirtualMotorCore_ProductBuild, VirtualMotorCore_ProductRevision
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", VirtualMotorCore_CompanyNameStr
            VALUE "FileDescription", RC_FILE_DESCRIPTION
            VALUE "FileVersion", VirtualMotorCore_FileVersionRcStr
            VALUE "InternalName", VirtualMotorCore_InternalNameStr
            VALUE "LegalCopyright", "Copyright (C) 2026 KosekiLab"
            VALUE "OriginalFilename", VirtualMotorCore_InternalNameStr ".sys"
            VALUE "ProductName", "Experiment Hail Mary"
            VALUE "ProductVersion", VirtualMotorCore_ProductVersionRcStr
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

/////////////////////////////////////////////////////////////////////////////
