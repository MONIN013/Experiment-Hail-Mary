/////////////////////////////////////////////////////////////////////////////
//
// Version
//

#include "ControllerCoreVersion.h"

#define RC_MAKE_STR(m) #m
#define RC_MACRO_AS_STR(m) RC_MAKE_STR(m)

#define RC_FILE_DESCRIPTION "TwinCAT C++ Executable for '" RC_MACRO_AS_STR(TC_CFG_PLTF) "'"



1 VERSIONINFO
 FILEVERSION ControllerCore_FileVersionMajor, ControllerCore_FileVersionMinor, ControllerCore_FileVersionBuild, ControllerCore_FileVersionRevision
 PRODUCTVERSION ControllerCore_ProductMajor, ControllerCore_ProductMinor, ControllerCore_ProductBuild, ControllerCore_ProductRevision
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", ControllerCore_CompanyNameStr
            VALUE "FileDescription", RC_FILE_DESCRIPTION
            VALUE "FileVersion", ControllerCore_FileVersionRcStr
            VALUE "InternalName", ControllerCore_InternalNameStr
            VALUE "LegalCopyright", "Copyright (C) 2026 KosekiLab"
            VALUE "OriginalFilename", ControllerCore_InternalNameStr ".sys"
            VALUE "ProductName", "Experiment Hail Mary"
            VALUE "ProductVersion", ControllerCore_ProductVersionRcStr
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

/////////////////////////////////////////////////////////////////////////////
