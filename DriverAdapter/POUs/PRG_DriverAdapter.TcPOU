<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="PRG_DriverAdapter" Id="{2b6eb1d8-78de-49a3-a5f1-da880c0ef4fc}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM PRG_DriverAdapter
VAR
    targetCurrentLocal : LREAL := 0.0;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[targetCurrentLocal := GVL_DRV.controlInput + GVL_DRV.distValue;

IF GVL_DRV.enableCurrentOutput THEN
    GVL_DRV.targetTorque := targetCurrentLocal;
ELSE
    GVL_DRV.targetTorque := 0.0;
END_IF

GVL_DRV.controlWordOut := GVL_DRV.controlWordIn;
GVL_DRV.statusWordOut := GVL_DRV.statusWord;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>