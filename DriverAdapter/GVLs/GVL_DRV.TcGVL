<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <GVL Name="GVL_DRV" Id="{d6ba9544-b58c-4d6e-9a35-2da4b87a7cb0}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
    ENCODER_RESOLUTION : UDINT := 8388608; (* pulses/rev *)
    RATED_CURRENT : LREAL := 1.2;          (* A — 定格電流 *)
    MAX_CURRENT_A : LREAL := 1.5;          (* A — 電流クランプ上限 (モーター保護) *)
    TWO_PI_INV_RES : LREAL := 6.283185307179586 / 8388608.0; (* rad/pulse *)
    RATED_CURRENT_INV_X1000 : LREAL := 1000.0 / 1.2;         (* permille/A *)
    RATED_CURRENT_DIV_1000 : LREAL := 1.2 / 1000.0;          (* A/permille *)
END_VAR

VAR_GLOBAL
    {attribute 'linkalways'}
    positionRel AT %Q* : LREAL := 0.0;

    {attribute 'linkalways'}
    velocityAct AT %Q* : LREAL := 0.0;

    {attribute 'linkalways'}
    currentAct AT %Q* : LREAL := 0.0;

    {attribute 'linkalways'}
    statusWordOut AT %Q* : UINT := 0;

    {attribute 'linkalways'}
    targetTorque AT %Q* : INT := 0;

    {attribute 'linkalways'}
    controlWordOut AT %Q* : UINT := 0;

    {attribute 'linkalways'}
    positionActualValue AT %I* : DINT := 0;

    {attribute 'linkalways'}
    velocityActualValue AT %I* : DINT := 0;

    {attribute 'linkalways'}
    torqueActualValue AT %I* : INT := 0;

    {attribute 'linkalways'}
    statusWord AT %I* : UINT := 0;

    {attribute 'linkalways'}
    controlInput AT %I* : LREAL := 0.0;

    {attribute 'linkalways'}
    distValue AT %I* : LREAL := 0.0;

    {attribute 'linkalways'}
    controlWordIn AT %I* : UINT := 0;

    {attribute 'linkalways'}
    enableCurrentOutput AT %I* : BOOL := TRUE;

    {attribute 'linkalways'}
    resetReq AT %I* : BOOL := FALSE;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>
