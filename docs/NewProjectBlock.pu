@startuml
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontSize 11

title Next-Gen Experiment Platform — Module Architecture

' ============================================================
'  TwinCAT Real-Time Layer
' ============================================================
package "TwinCAT Real-Time (Phase 1-3: 1 ms / Phase 4: 125 µs = 8 kHz)" {

  ' ---- Drive / Plant ----
  package "VirtualMotorCore\n(C++ TcCOM — Phase 1-3)\nor EtherCAT Drive\n(Phase 4)" as Drive {
    [CiA 402\nState Machine] as CiA
    [PDO I/O\n(EtherCAT / Virtual)] as PDO
  }

  ' ---- DriverAdapter (PLC ST — ControlInput→Drive整形 + CW/SW中継) ----
  package "DriverAdapter\n(PLC ST)" as DA {
    [Dist Adder\n(target = control_input + dist_value)] as DistAddDrv
    [ControlWord\nRelay] as CWRelay
    [StatusWord\nRelay] as SWRelay
  }

  ' ---- ControllerCore (C++ TcCOM — 誤差計算 + FB Chain + FF付加) ----
  package "ControllerCore\n(C++ TcCOM\nテーブル非所有・スカラ I/O)" as CC {
    [Error Calc\n(e = r - y)] as Err

    package "FB Chain (各ブロック enable/bypass)" {
      [PID\n(Discrete)] as PID
      [Lead\nCompensator] as Lead
      [Notch\nFilter] as Notch
      [Phase-Optimal\nResonance Filter] as Reso
    }

    [FF Adder\n(u = u_fb + ff_value)] as FFAdd
  }

  ' ---- ExperimentSequencer (PLC ST — テーブル読み出し専用) ----
  package "ExperimentSequencer\n(PLC ST\nテーブル読み出し専用)" as Seq {
    [Ref Table Replay\n(ref_table)] as RefTbl
    [FF Table Replay\n(ff_table)] as FF
    [Dist Table Replay\n(dist_table)] as Dist
  }

  ' ---- ModeManager (PLC ST) ----
  [ModeManager\n(PLC ST, 10 ms)\nCiA 402 + 実験シーケンス\n+ 安全監視] as Mode

  ' ---- ExperimentLogger (C++ TcCOM) ----
  [ExperimentLogger\n(C++ TcCOM, File Writer)] as Log

  ' ---- Data flow: Drive → ControllerCore (Load 側 FB) ----
  PDO --> Err : load_position\n(Load 側 FB)
  PDO --> Log : motor/load\nposition, velocity\nmotor_current_act

  ' ---- ExperimentSequencer → ControllerCore (スカラ) ----
  RefTbl --> Err : ref_value\n(scalar)
  FF --> FFAdd : ff_value\n(scalar)

  ' ---- ExperimentSequencer → DriverAdapter (dist_value) ----
  Dist --> DistAddDrv : dist_value\n(scalar)

  ' ---- ControllerCore internal ----
  Err --> PID : error
  PID --> Lead
  Lead --> Notch
  Notch --> Reso
  Reso --> FFAdd : u_fb

  ' ---- ControllerCore → DriverAdapter ----
  FFAdd --> DistAddDrv : control_input\n(u_fb + u_ff)

  ' ---- DriverAdapter → Drive (Motor 側入力) ----
  DistAddDrv --> PDO : target_torque\n(Motor 側)

  ' ---- ModeManager → DriverAdapter → Drive (ControlWord) ----
  Mode --> CWRelay : controlword
  CWRelay --> CiA : controlword_out

  ' ---- Drive → DriverAdapter → ModeManager (StatusWord) ----
  CiA --> SWRelay : statusword
  SWRelay --> Mode : statusword_out

  ' ---- ModeManager → ExperimentSequencer ----
  Mode --> Seq : mode_flags\nexperiment_active

  ' ---- Logging ----
  Err --> Log : error
  DistAddDrv --> Log : torque_cmd
  RefTbl --> Log : ref_value
  FF --> Log : ff_value
  FFAdd --> Log : control_input
  PDO --> Log : load_position\nload_velocity
}

' ============================================================
'  MATLAB Non-RT Layer
' ============================================================
package "MATLAB (Non-RT)" {
  [Experiment\nOrchestrator] as Matlab
}

' ---- ADS parameter injection (Non-RT → RT) ----
Matlab --> Mode : ADS\n(mode_flags)
Matlab --> CC : ADS\n(PID/Lead/Notch/Reso params\nenable_* flags)
Matlab --> RefTbl : ADS\n(ref_table[])
Matlab --> FF : ADS\n(ff_table[])
Matlab --> Dist : ADS\n(dist_table[])

' ---- ADS data pull (RT → Non-RT) ----
Log --> Matlab : ファイル読出し\n(実験後)

' ============================================================
'  Notes
' ============================================================
note right of CC
  C++ TcCOM で制御構造を直接実装。
  **テーブル (ref/ff/dist) は所有しない。**
  入力: ref_value, ff_value, position_act (全スカラ)
  position_act = **Load 側**実位置 (FB 対象)
  出力: control_input (u_fb + ff_value) → DriverAdapter
  ゲイン・係数は ADS Tunable Parameter で注入。
end note

note right of Seq
  テーブル所有・テーブルリプレイのみ。
  **ref / ff / dist のスカラ出力に専念。**
  Dist 加算は DriverAdapter が担当。
  テーブルは GVL 配列として ADS 経由で注入。
end note

note right of DA
  **ControlInput → Drive 入力整形アダプタ。**
  Dist Adder: target = control_input + dist_value
  ModeManager → ControlWord → Drive (中継)
  Drive → StatusWord → ModeManager (中継)
  Phase 1-3: VirtualMotorCore I/F に接続
  Phase 4: EtherCAT PDO に切り替え
end note

note right of Drive
  **2慣性系:** target_torque → Motor 側
  position FB ← Load 側エンコーダ
  Phase 1-3: VirtualMotorCore (1慣性近似)
  Phase 4: EtherCAT Drive (Motor+Load 実機)
  同一 Data Area I/F で差し替え可能。
end note

note bottom of Log
  C++ TcCOM ファイルライタ方式。
  8kHz × 100s = 800,000 サンプル ≈ 67 MB。
  Motor/Load 両方の信号を記録。
  内部バッファ付きバイナリファイル出力。
  実験後に MATLAB から読み出し。
end note

@enduml
