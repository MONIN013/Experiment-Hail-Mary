%[text] # 概要
%[text] ```
%[text] 実機を対象とした Feedback Control 用の実験ファイル。
%[text] 現行の ExperimentConfig / ExperimentRunner / ExperimentLogger を使い、
%[text] ControllerCore の PID biquad 係数を ADS 経由で書き込んで閉ループ応答を確認する。
%[text] ```
%[text] ```
%[text] 注意:
%[text]   - 本ファイルは実機用であり、現在の数値は安全確認用の小さい例である
%[text]   - 実行前に機械系の可動範囲、非常停止、配線、logger 保存先を確認すること
%[text]   - PID ゲインと軌道は実験条件に応じて段階的に調整すること
%[text] ```
%[text] ## 前提確認
%[text] ```
%[text] - TwinCAT は実機マッピング側の project / runtime を使用していること
%[text] - ExperimentLogger が `SystemConfig.LOGGER_DEFAULT_FILE_PATH` に書き込めること
%[text] - ControllerCore の PIDParams / EnableParams が Port 351 から書き込めること
%[text] - 位置指令、位置応答、制御入力は rad / A 単位で扱うこと
%[text] ```
%[text] ## セットアップ
%[text] `run('matlab/setup_matlab_environment.m')` を一度実行し、起動時 PATH 設定が完了していること。

sys = config.SystemConfig;
cfg = experiment.ExperimentConfig.defaults();
logger_file_glob = "*.bin";
logger_dir = string(fileparts(char(sys.LOGGER_DEFAULT_FILE_PATH)));
%%
%[text] ## 制御器設計
%[text] $K = k\_p + \\frac{k\_i}{s} + k\_d \\frac{s}{1 + T\_f s}$ 
Ts = 1 / cfg.task_rate_hz;
Kp = 0.7;
Ki = 0.4;
Kd = 2.5e-03;
Tf = 0.025;

K_cont = pid(Kp, Ki, Kd, Tf);
Kd_z = c2d(K_cont, Ts, "tustin");
controller_cfg = controller_config_from_discrete_tf(Kd_z);

controller_params = controller_cfg.to_flat_struct();
controller_summary = struct( ... %[output:group:53e31fb4] %[output:77decb12]
  "Kp", Kp, ... %[output:77decb12]
  "Ki", Ki, ... %[output:77decb12]
  "Kd", Kd, ... %[output:77decb12]
  "Tf", Tf, ... %[output:77decb12]
  "Ts", Ts, ... %[output:77decb12]
  "pid_b0", controller_params.pid_b0, ... %[output:77decb12]
  "pid_b1", controller_params.pid_b1, ... %[output:77decb12]
  "pid_b2", controller_params.pid_b2, ... %[output:77decb12]
  "pid_a1", controller_params.pid_a1, ... %[output:77decb12]
  "pid_a2", controller_params.pid_a2) %[output:group:53e31fb4] %[output:77decb12]
%%
%[text] ## 制御器確認
%[text] 実機前に離散制御器の周波数特性を確認する。Plant 同定結果を使う場合は、この節に開ループ確認を追加する。
figure("Name", "Feedback Controller", "Color", "w"); %[output:593f31f3]
bode(Kd_z); %[output:593f31f3]
grid on; %[output:593f31f3]
title("Discrete PIDF Controller"); %[output:593f31f3]
%%
%[text] ## 軌道生成
%[text] 既定は小さい位置ステップ。S字軌道に切り替える場合は `trajectory_mat_path` に mat ファイルを指定する。
%[text] mat ファイルから読む場合、`trajectory_variable_name` の numeric vector を \[rad\] としてそのまま使い、リサンプリングは行わない。
trajectory_mat_path = "";
trajectory_variable_name = "ref_profile";

target_position_rad = deg2rad(2);
pre_step_s = 1.0;
step_hold_s = 2.0;
repeat_count = 1;
hold_margin_s = 1.0;

if strlength(strtrim(string(trajectory_mat_path))) > 0
  ref_profile = load_reference_profile_from_mat(trajectory_mat_path, trajectory_variable_name);
else
  ref_profile = build_step_reference(target_position_rad, pre_step_s, step_hold_s, Ts);
end

sample_n = numel(ref_profile);
per_trial_s = sample_n * Ts;
t_ref = (0:sample_n-1)' * Ts;

figure("Name", "Reference Profile", "Color", "w"); %[output:5219504d]
plot(t_ref, ref_profile, "-", "LineWidth", 1.2); %[output:5219504d]
grid on; %[output:5219504d]
xlabel("Time [s]"); %[output:5219504d]
ylabel("Position [rad]"); %[output:5219504d]
title("Reference Profile"); %[output:5219504d]
%%
%[text] ## 実験実行
%[text] ref / ff / dist table と ControllerCore の PID biquad を書き込み、ExperimentLogger の bin を結果として読む。
cfg.ref_profile = ref_profile(:);
cfg.ff_profile = zeros(sample_n, 1);
cfg.dist_profile = zeros(sample_n, 1);
cfg.repeat_count = repeat_count;
cfg.wait_for_done = true;
cfg.hold_seconds = per_trial_s + hold_margin_s;
cfg.done_timeout_s = repeat_count * per_trial_s + hold_margin_s + 5.0;
cfg.logger_release_timeout_s = max(5.0, repeat_count * per_trial_s / 10);
cfg.controller = controller_cfg;

status_text = struct();
status_text.header = sprintf("=== Real Motor Feedback Template ===\n");
status_text.config_line = sprintf("Ts=%.6f s, samples=%d, perTrial=%.3f s, repeats=%d\n", ...
  Ts, sample_n, per_trial_s, repeat_count);
status_text.controller_line = sprintf("PIDF: Kp=%.6g, Ki=%.6g, Kd=%.6g, Tf=%.6g\n", ...
  Kp, Ki, Kd, Tf);
status_text.logger_line = sprintf("loggerDir=%s\n", logger_dir);

conn = experiment.ConnectionManager.create(cfg);
cleanup = onCleanup(@() conn.session.close()); 
status_text.connection_line = sprintf("Connected: SEQ=%d, CTRL=%d, MODULE=%d\n", ...
  cfg.seq_port, cfg.control_port, cfg.module_port);

run_out = experiment.ExperimentRunner.run(conn, cfg);
latest_bin = experiment.read_latest_logger_bin(logger_dir, logger_file_glob);
if ~latest_bin.ok
  error("experiment:exp02_feedback:loggerUnavailable", ...
    "ExperimentLogger bin is unavailable (%s).", string(latest_bin.reason));
end
logger_bin = latest_bin.logger_bin;
%%
%[text] ## 結果整理
%[text] Logger bin の ref / load position / error / control input / current command を解析用変数に展開する。
raw = logger_bin.raw;
t_log = raw.t_s(:);
if ~isempty(t_log)
  t_log = t_log - t_log(1);
end
r_log = raw.ref_value(:);
y_log = raw.load_position(:);
e_log = raw.error(:);
u_log = raw.control_input(:);
i_cmd_log = raw.current_cmd(:);
tracking_error_l2 = norm(e_log);

status_text.result_header = sprintf("\n--- Result ---\n");
status_text.run_line = sprintf("done=%d timed_out=%d stopReason=%s\n", ...
  logical(run_out.host.done), logical(run_out.host.timed_out), string(run_out.host.stop_reason));
status_text.result_logger_line = sprintf("logger=%s records=%d file=%s\n", ...
  string(latest_bin.reason), logger_bin.record_count, string(logger_bin.file_path));
status_text.error_line = sprintf("trackingErrorL2=%.6g, maxAbsError=%.6g, maxAbsControlInput=%.6g A\n", ...
  tracking_error_l2, max(abs(e_log), [], "omitnan"), max(abs(u_log), [], "omitnan"));

feedback_out = struct( ...
  "run", run_out, ...
  "logger_bin", logger_bin, ...
  "controller", controller_summary, ...
  "reference", struct( ...
    "profile", ref_profile(:), ...
    "time_s", t_ref, ...
    "trajectory_mat_path", string(trajectory_mat_path), ...
    "trajectory_variable_name", string(trajectory_variable_name)), ...
  "signals", struct( ...
    "time_s", t_log, ...
    "ref_value", r_log, ...
    "position_act", y_log, ...
    "error", e_log, ...
    "control_input", u_log, ...
    "current_cmd", i_cmd_log), ...
  "metrics", struct( ...
    "tracking_error_l2", tracking_error_l2, ...
    "max_abs_error", max(abs(e_log), [], "omitnan"), ...
    "max_abs_control_input", max(abs(u_log), [], "omitnan")));
%%
%[text] ## 可視化
%[text] 追従応答、誤差、制御入力を確認する。
figure("Name", "Feedback Experiment Result", "Color", "w"); %[output:16f70b8c]
tiledlayout(3, 1, "Padding", "compact", "TileSpacing", "compact"); %[output:16f70b8c]

nexttile; %[output:16f70b8c]
plot(t_log, r_log, "-", "Color", [0.55 0.55 0.55], "LineWidth", 0.9, "DisplayName", "ref"); hold on; %[output:16f70b8c]
plot(t_log, y_log, "-", "Color", [0.1 0.45 0.75], "LineWidth", 1.2, "DisplayName", "loadPosition"); %[output:16f70b8c]
hold off; %[output:16f70b8c]
grid on; %[output:16f70b8c]
xlabel("Time [s]"); %[output:16f70b8c]
ylabel("Position [rad]"); %[output:16f70b8c]
legend("Location", "best"); %[output:16f70b8c]
title("Tracking"); %[output:16f70b8c]

nexttile; %[output:16f70b8c]
plot(t_log, e_log, "-", "Color", [0.85 0.25 0.2], "LineWidth", 1.2); %[output:16f70b8c]
grid on; %[output:16f70b8c]
xlabel("Time [s]"); %[output:16f70b8c]
ylabel("Error [rad]"); %[output:16f70b8c]
title(sprintf("Tracking Error (L2 = %.4g)", tracking_error_l2)); %[output:16f70b8c]

nexttile; %[output:16f70b8c]
plot(t_log, u_log, "-", "Color", [0.45 0.25 0.75], "LineWidth", 1.2, "DisplayName", "controlInput"); hold on; %[output:16f70b8c]
plot(t_log, i_cmd_log, "--", "Color", [0.2 0.6 0.2], "LineWidth", 0.9, "DisplayName", "currentCmd"); %[output:16f70b8c]
hold off; %[output:16f70b8c]
grid on; %[output:16f70b8c]
xlabel("Time [s]"); %[output:16f70b8c]
ylabel("Current [A]"); %[output:16f70b8c]
legend("Location", "best"); %[output:16f70b8c]
title("Controller Output"); %[output:16f70b8c]
%%
%[text] ## 次の調整指針
%[text] ```
%[text] - 最初は小さいステップで logger records / error / current を確認する
%[text] - S字軌道へ移行する場合は mat 内の `ref_profile` を [rad] の列ベクトルで保存する
%[text] - PID を強くする前に `max_abs_control_input` と機械系の可動範囲を確認する
%[text] - Plant 同定結果がある場合は、制御器確認節に開ループ安定性確認を追加する
%[text] - 必要なら `feedback_out` を起点に Live Editor 上で追加解析を行う
%[text] ```

function controller_cfg = controller_config_from_discrete_tf(Kd_z)
pid_stage = biquad_stage_from_discrete_tf(Kd_z);
controller_cfg = experiment.ControllerConfig();
controller_cfg.pid = pid_stage;
controller_cfg.lead = experiment.BiquadStage.passthrough();
controller_cfg.notch = experiment.BiquadStage.passthrough();
controller_cfg.reso = experiment.BiquadStage.passthrough();
end

function stage = biquad_stage_from_discrete_tf(Kd_z)
[num, den] = tfdata(Kd_z, "v");
num = normalize_polynomial(num);
den = normalize_polynomial(den);
if numel(num) > 3 || numel(den) > 3
  error("experiment:exp02_feedback:unsupportedControllerOrder", ...
    "ControllerCore PID stage supports up to second-order discrete transfer functions.");
end
if isempty(den) || den(1) == 0
  error("experiment:exp02_feedback:invalidController", ...
    "Discrete controller denominator must have a nonzero leading coefficient.");
end

num = num ./ den(1);
den = den ./ den(1);
num(end+1:3) = 0;
den(end+1:3) = 0;

stage = experiment.BiquadStage.from_struct(struct( ...
  "b0", num(1), ...
  "b1", num(2), ...
  "b2", num(3), ...
  "a1", den(2), ...
  "a2", den(3), ...
  "enable", true));
end

function p = normalize_polynomial(p)
p = double(p(:).');
while numel(p) > 1 && p(1) == 0
  p = p(2:end);
end
end

function ref_profile = load_reference_profile_from_mat(file_path, variable_name)
file_path = string(file_path);
variable_name = char(string(variable_name));
if ~isfile(file_path)
  error("experiment:exp02_feedback:trajectoryMissing", ...
    "Trajectory mat file not found: %s", file_path);
end
data = load(file_path, variable_name);
if ~isfield(data, variable_name)
  error("experiment:exp02_feedback:trajectoryVariableMissing", ...
    "Trajectory variable '%s' is missing in %s.", variable_name, file_path);
end
ref_profile = data.(variable_name);
if ~isnumeric(ref_profile) || ~isvector(ref_profile) || isempty(ref_profile)
  error("experiment:exp02_feedback:invalidTrajectory", ...
    "Trajectory variable '%s' must be a nonempty numeric vector in rad.", variable_name);
end
ref_profile = double(ref_profile(:));
end

function ref_profile = build_step_reference(target_position_rad, pre_step_s, step_hold_s, Ts)
pre_step_n = max(1, round(pre_step_s / Ts));
step_hold_n = max(1, round(step_hold_s / Ts));
ref_profile = [
  zeros(pre_step_n, 1)
  double(target_position_rad) * ones(step_hold_n, 1)
];
end

