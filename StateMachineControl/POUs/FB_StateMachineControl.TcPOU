<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_StateMachineControl" Id="{0986dcd7-5bfc-407b-88b3-426bbb5a0a8b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_StateMachineControl
VAR_INPUT
    statusWord : UINT; // 0x6041
    enable      : BOOL := TRUE;
END_VAR
VAR_OUTPUT
    controlWord : UINT;      // 0x6040
    driveState   : E_DriveState;
END_VAR
VAR
    faultResetPulsed : BOOL := FALSE;
END_VAR
VAR CONSTANT
    // Common CiA402 control commands (0x6040)
    CW_DISABLE_VOLTAGE : UINT := 16#0000;
    CW_SHUTDOWN        : UINT := 16#0006;
    CW_SWITCH_ON       : UINT := 16#0007;
    CW_ENABLE_OP       : UINT := 16#000F;
    CW_FAULT_RESET     : UINT := 16#0080;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[driveState := F_DecodeDriveState(statusWord);

// Disable requested: force safe output
IF NOT enable THEN
    controlWord := CW_DISABLE_VOLTAGE;
    faultResetPulsed := FALSE;
    RETURN;
END_IF

CASE driveState OF

    E_DriveState.FAULT:
        // Fault reset should be a pulse. One scan is usually enough.
        IF NOT faultResetPulsed THEN
            controlWord := CW_FAULT_RESET;
            faultResetPulsed := TRUE;
        ELSE
            controlWord := CW_DISABLE_VOLTAGE;
        END_IF

    E_DriveState.SWITCH_ON_DISABLED:
        controlWord := CW_SHUTDOWN;
        faultResetPulsed := FALSE;

    E_DriveState.READY_TO_SWITCH_ON:
        controlWord := CW_SWITCH_ON;
        faultResetPulsed := FALSE;

    E_DriveState.SWITCHED_ON:
        controlWord := CW_ENABLE_OP;
        faultResetPulsed := FALSE;

    E_DriveState.OPERATION_ENABLED:
        controlWord := CW_ENABLE_OP;
        faultResetPulsed := FALSE;

    ELSE
        // UNKNOWN: converge from below (safe)
        controlWord := CW_SHUTDOWN;
        faultResetPulsed := FALSE;
END_CASE]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
