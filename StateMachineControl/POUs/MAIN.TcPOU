<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="MAIN" Id="{9328c0c8-0c23-447b-8f8c-ef2a688ee9a0}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    ctrlWord AT%Q* : UINT; // ControlWord output
    statWord AT%I* : UINT; // StatusWord input
    seqPlaybackDone AT%I* : BOOL; // Sequencer playback done (latched)
    experimentActiveOut AT%Q* : BOOL; // ModeManager experiment active output
    preArmOut AT%Q* : BOOL; // ModeManager logger pre-arm output
    resetOut AT%Q* : BOOL; // One-shot reset pulse output
    enableCurrentOut AT%Q* : BOOL; // Current enable gate output

    // FSM state
    modeState : E_ModeState := E_ModeState.IDLE;

    // Decoded request flags (from GVL_MODE.modeFlags)
    servoEnableReq : BOOL := FALSE;
    experimentStartReq : BOOL := FALSE;
    servoEnableReqPrev : BOOL := FALSE;
    experimentStartReqPrev : BOOL := FALSE;
    servoEnableEdge : BOOL := FALSE;
    experimentStartEdge : BOOL := FALSE;
    servoEnableLatched : BOOL := FALSE;
    experimentStartLatched : BOOL := FALSE;

    // Reset edge detection
    resetReqPrev : BOOL := FALSE;
    resetReqCurrent : BOOL := FALSE;
    resetEdge : BOOL := FALSE;
    resetHoldTicksRemaining : UDINT := 0;
    RESET_PULSE_HOLD_TICKS : UDINT := 1;

    // Drive state
    driveReady : BOOL := FALSE;
    enableEffective : BOOL := FALSE;

    // Watchdog
    heartbeatCounterPrev : UDINT := 0;
    heartbeatSilenceTicks : UDINT := 0;
    watchdogArmed : BOOL := FALSE;
    watchdogTripLatched : BOOL := FALSE;
    heartbeatChanged : BOOL := FALSE;
    watchdogTimeout : BOOL := FALSE;

    fbStateMachine : FB_StateMachineControl;
    loggerReadyIn AT%I* : BOOL; // ExperimentLogger file FSM ACTIVE
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[(* ===== 1. Decode input flags ===== *)
servoEnableReq := (GVL_MODE.modeFlags AND GVL_MODE.MODEF_SERVO_ENABLE) <> 0;
experimentStartReq := (GVL_MODE.modeFlags AND GVL_MODE.MODEF_EXPERIMENT_START_REQ) <> 0;
servoEnableEdge := servoEnableReq AND NOT servoEnableReqPrev;
experimentStartEdge := experimentStartReq AND NOT experimentStartReqPrev;
servoEnableReqPrev := servoEnableReq;
experimentStartReqPrev := experimentStartReq;

IF servoEnableEdge THEN
    servoEnableLatched := TRUE;
END_IF
IF experimentStartEdge THEN
    experimentStartLatched := TRUE;
END_IF

(* ===== 2. Reset edge detection ===== *)
resetReqCurrent := GVL_MODE.resetReq;
resetEdge := resetReqCurrent AND NOT resetReqPrev;
IF resetEdge THEN
    GVL_MODE.resetReq := FALSE;
END_IF
resetReqPrev := resetReqCurrent;

(* ===== 3. Watchdog ===== *)
watchdogArmed := (GVL_MODE.modeFlags <> 0) OR GVL_MODE.experimentActive OR servoEnableLatched;
heartbeatChanged := (GVL_MODE.hostHeartbeatCounter <> heartbeatCounterPrev);

IF NOT watchdogArmed THEN
    heartbeatCounterPrev := GVL_MODE.hostHeartbeatCounter;
    heartbeatSilenceTicks := 0;
    watchdogTripLatched := FALSE;
ELSIF heartbeatChanged THEN
    heartbeatCounterPrev := GVL_MODE.hostHeartbeatCounter;
    heartbeatSilenceTicks := 0;
    watchdogTripLatched := FALSE;
ELSE
    IF heartbeatSilenceTicks < GVL_MODE.HEARTBEAT_TIMEOUT_TICKS THEN
        heartbeatSilenceTicks := heartbeatSilenceTicks + 1;
    END_IF
END_IF
watchdogTimeout := watchdogArmed AND (heartbeatSilenceTicks >= GVL_MODE.HEARTBEAT_TIMEOUT_TICKS);

(* ===== 4. FSM transitions ===== *)

(* 4a. Global preemptive transitions: watchdog and reset *)
IF watchdogTimeout THEN
    (* Watchdog trip: force IDLE, clear all *)
    modeState := E_ModeState.IDLE;
    GVL_MODE.modeFlags := 0;
    GVL_MODE.experimentActive := FALSE;
    servoEnableLatched := FALSE;
    experimentStartLatched := FALSE;
    IF NOT watchdogTripLatched THEN
        GVL_MODE.watchdogTripCounter := GVL_MODE.watchdogTripCounter + 1;
        watchdogTripLatched := TRUE;
    END_IF

ELSIF resetEdge THEN
    (* Reset edge from any state: enter RESETTING *)
    modeState := E_ModeState.RESETTING;
    resetHoldTicksRemaining := RESET_PULSE_HOLD_TICKS;
    GVL_MODE.experimentActive := FALSE;
    GVL_MODE.modeFlags := 0;
    servoEnableLatched := FALSE;
    experimentStartLatched := FALSE;
    GVL_MODE.resetAckCounter := GVL_MODE.resetAckCounter + 1;

ELSE
    (* 4b. Per-state transitions *)
    CASE modeState OF

        E_ModeState.IDLE:
            IF servoEnableLatched THEN
                modeState := E_ModeState.SERVO_READY;
            END_IF

        E_ModeState.RESETTING:
            IF resetHoldTicksRemaining > 0 THEN
                resetHoldTicksRemaining := resetHoldTicksRemaining - 1;
            ELSE
                modeState := E_ModeState.IDLE;
            END_IF

        E_ModeState.SERVO_READY:
            IF NOT servoEnableLatched THEN
                modeState := E_ModeState.IDLE;
                experimentStartLatched := FALSE;
            ELSIF experimentStartLatched AND driveReady AND loggerReadyIn THEN
                modeState := E_ModeState.RUNNING;
                GVL_MODE.experimentActive := TRUE;
                experimentStartLatched := FALSE;
            END_IF

        E_ModeState.RUNNING:
            IF NOT servoEnableLatched THEN
                modeState := E_ModeState.IDLE;
                GVL_MODE.experimentActive := FALSE;
                experimentStartLatched := FALSE;
            ELSIF seqPlaybackDone THEN
                modeState := E_ModeState.DONE;
                GVL_MODE.experimentActive := FALSE;
                servoEnableLatched := FALSE;
                experimentStartLatched := FALSE;
                (* End of experiment: force servo-off request clear *)
                GVL_MODE.modeFlags := 0;
            END_IF

        E_ModeState.DONE:
            (* One-tick notification state: unconditionally return to IDLE *)
            modeState := E_ModeState.IDLE;
            servoEnableLatched := FALSE;
            experimentStartLatched := FALSE;

    END_CASE
END_IF

(* ===== 5. State-dependent outputs ===== *)
enableEffective := servoEnableLatched
                    AND (modeState = E_ModeState.SERVO_READY
                      OR modeState = E_ModeState.RUNNING);

fbStateMachine(
    statusWord := statWord,
    enable      := enableEffective
);

ctrlWord := fbStateMachine.controlWord;
driveReady := (fbStateMachine.driveState = E_DriveState.OPERATION_ENABLED);

(* Outputs purely from FSM state *)
CASE modeState OF
    E_ModeState.IDLE:
        experimentActiveOut := FALSE;
        preArmOut := FALSE;
        resetOut := FALSE;
        enableCurrentOut := FALSE;
        GVL_MODE.experimentState := GVL_MODE.STATE_IDLE;

    E_ModeState.RESETTING:
        experimentActiveOut := FALSE;
        preArmOut := FALSE;
        resetOut := TRUE;
        enableCurrentOut := FALSE;
        GVL_MODE.experimentState := GVL_MODE.STATE_IDLE;

    E_ModeState.SERVO_READY:
        experimentActiveOut := FALSE;
        preArmOut := TRUE;
        resetOut := FALSE;
        enableCurrentOut := TRUE;
        GVL_MODE.experimentState := GVL_MODE.STATE_READY;

    E_ModeState.RUNNING:
        experimentActiveOut := TRUE;
        preArmOut := FALSE;
        resetOut := FALSE;
        enableCurrentOut := TRUE;
        GVL_MODE.experimentState := GVL_MODE.STATE_RUNNING;

    E_ModeState.DONE:
        experimentActiveOut := FALSE;
        preArmOut := FALSE;
        resetOut := FALSE;
        enableCurrentOut := FALSE;
        GVL_MODE.experimentState := GVL_MODE.STATE_DONE;
END_CASE

GVL_MODE.experimentActive := experimentActiveOut;
GVL_MODE.modeState := modeState;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
