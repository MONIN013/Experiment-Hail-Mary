<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_ModeState" Id="{8c0d4d84-5cf2-489d-acbf-25f5f975c44d}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_ModeState :
(
    IDLE := 0,              // Servo OFF / initial
    RESETTING := 10,        // Reset pulse active — no experiment transitions allowed
    SERVO_READY := 20,      // Servo ON + drive OPERATION_ENABLED, awaiting experiment
    RUNNING := 30,          // Experiment active
    DONE := 40              // Playback complete, awaiting rearm
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>